# Copy to backend/.env and adjust. Values here are used ONLY when the same
# variable is not already set in the environment (os.environ wins).

# SQLite database path (default: backend/portal.db)
# PORTAL_DB_PATH=portal.db

# JWT signing secret (must be >= 32 bytes for HS256)
# PORTAL_JWT_SECRET=change-me-32-bytes-minimum-0123456789

# JWT lifetime in minutes (default: 60)
# PORTAL_JWT_EXPIRES_MINUTES=60

# Admin bootstrap account, created on app startup if it does not exist yet
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me

# Directory with vendored source data files (parquet) for seeding
# PORTAL_DATA_DIR=data